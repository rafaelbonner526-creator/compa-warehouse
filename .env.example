# Source CSVs directory (holds leads-master.csv, touch-log.csv)
COMPA_LEADS_DIR=/absolute/path/to/leads/dir

# Warehouse target: duckdb (default, local dev) or bigquery (cloud/prod)
WAREHOUSE_TARGET=duckdb

# BigQuery -- only needed when WAREHOUSE_TARGET=bigquery or dbt --target prod
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json
GCP_PROJECT=your-gcp-project-id
